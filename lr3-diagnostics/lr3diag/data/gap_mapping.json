{
  "_readme": "Maps channel names in exported logs (GAP IIDTool live-data CSV, or other CSV tools) to lr3diag channels. Values must end up metric (°C, km/h, mm), so use scale/offset to convert. Names CONFIRMED from a real IIDControl 4.3 export are listed first; the rest are PLACEHOLDERS, so correct them once you have a log that includes those values. Matching ignores case, spaces and punctuation. Copy this file to ~/.lr3diag/gap_mapping.json to customise it.",
  "time_column": "Time",
  "time_scale": 1.0,
  "columns": {
    "Absolute throttle position": "throttle",
    "Transmission current gear": "gear",
    "Short term fuel trim (bank 1)": "stft1",
    "Short term fuel trim (bank 2)": "stft2",
    "Long term fuel trim (bank 1)": "ltft1",
    "Long term fuel trim (bank 2)": "ltft2",
    "Vehicle speed": {
      "channel": "speed",
      "scale": 1.609344,
      "_note": "GAP exported mph on this phone; set scale to 1.0 if your app is set to km/h"
    },
    "Engine Speed Petrol": "rpm",
    "Lambda - bank 1": "lambda1",
    "Lambda - bank 2": "lambda2",
    "Air flow meter sensor": "maf_mv",
    "Equivalence ratio (lambda), bank 1 - sensor 1 (wide range oxygen sensor)": "lambda1",
    "Equivalence ratio (lambda), bank 2 - sensor 1 (wide range oxygen sensor)": "lambda2",
    "Oxygen sensor output voltage, bank 1 - sensor 2": "o2_b1s2",
    "Oxygen sensor output voltage, bank 2 - sensor 2": "o2_b2s2",
    "Short term fuel trim sensor 2 bank 1": "stft_b1s2",
    "Short term fuel trim sensor 2 bank 2": "stft_b2s2",
    "Universal heated exhaust gas oxygen heater pre-catalytic, bank 1": "o2_heater_b1s1",
    "Universal heated exhaust gas oxygen heater pre-catalytic, bank 2": "o2_heater_b2s1",
    "Engine speed": "rpm",
    "Engine coolant temperature": "coolant",
    "Intake air temperature": "iat",
    "Calculated load value": "load",
    "Mass air flow rate": "maf",
    "Battery voltage": "voltage",
    "Transmission fluid temperature": "trans_temp",
    "Gear selector position": "selector",
    "Transfer box range": "range",
    "Terrain Response mode": "terrain",
    "Ride height front left": "height_fl",
    "Ride height front right": "height_fr",
    "Ride height rear left": "height_rl",
    "Ride height rear right": "height_rr"
  }
}